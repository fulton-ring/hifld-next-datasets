<meta name="site-name" content="Oak Ridge National Lab"><meta property="og:site_name" content="Oak Ridge National Lab"><meta name="published-date" content="2023-02-02"><meta name="last-modified-date" content="2026-10-17"><meta name="post-title" content="Geospatial Data Sets"><meta property="og:type" content="article"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Geospatial Data Sets","datePublished":"2023-02-02T15:44:31-05:00","dateModified":"2026-09-22T17:32:32-04:00","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.ornl.gov/projects/geospatial-data-sets/"}}</script><meta property="og:title" content="Geospatial Data Sets"><meta property="og:description" content="We collect, curate, and deliver unique geospatial datasets that offer a full picture of human activities, the natural and built environment, and the interactions among them. Our datasets and platforms provide federal agencies and industry with information to better understand critical infrastructure, anticipate population changes , and respond quickly to disasters that threaten human and economic security."><meta property="og:url" content="https://www.ornl.gov/projects/geospatial-data-sets/"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Geospatial Data Sets"><meta name="twitter:description" content="We collect, curate, and deliver unique geospatial datasets that offer a full picture of human activities, the natural and built environment, and the interactions among them. Our datasets and platforms provide federal agencies and industry with information to better understand critical infrastructure, anticipate population changes , and respond quickly to disasters that threaten human and economic security."><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Oak Ridge National Lab","url":"https://www.ornl.gov"}</script><link rel="icon" href="https://www.ornl.gov/wp-c