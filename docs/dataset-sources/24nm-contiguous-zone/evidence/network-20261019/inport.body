      <div class="record-block">
        <div class="record-block-header cf">
          <h3 class="left force-break">Regional Digital Maritime Limits and Maritime Boundaries</h3>
          <div class="x-small right">CC ID: <span>601796</span></div>
        </div>
        <table class="name-value-table" aria-label="Regional Digital Maritime Limits and Maritime Boundaries">
          
          
          <tr>
  <th scope="col">
    Contact Name:
  </th>
  <td class="ellipsisize">National Oceanic and Atmospheric Administration (NOAA), National Ocean Service (NOS), Office of Coast Survey (OCS)</td>
</tr>
          <tr>
  <th scope="col">
    Publish Date:
  </th>
  <td class="ellipsisize">2011-05-01</td>
</tr>
          <tr>
  <th scope="col">
    Extent Type:
  </th>
  <td class="ellipsisize">Range</td>
</tr>
          <tr>
  <th scope="col">
