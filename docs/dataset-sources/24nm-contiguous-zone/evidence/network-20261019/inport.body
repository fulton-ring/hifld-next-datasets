      <!-- Section: Technical Environment -->
      
        <div id="technicalEnvironment" class="section metadataSection">
          <div class="section__header sh">
  <h2 class="sh__main" id="headerTechnicalEnvironment">Technical Environment</h2>
  
  
  
  
  

</div>
          <div class="section__content">
            
  

            
            
            
            <table class="name-value-table" aria-labelledby="headerTechnicalEnvironment">
              <tr>
  <th scope="col">
    Description:
  </th>
  <td class="small">
    
  <p>Caris Law of the Sea: Limits and Boundaries v.4.0 Service Pack 6 and v. 4.1; Esri ArcGIS Desktop 10.2.1+; Microsoft Windows 10</p>

  </td>
</tr>
            </table>
            
          </div>
