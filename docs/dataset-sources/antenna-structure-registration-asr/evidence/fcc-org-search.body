{"total":3,"start":1,"num":100,"nextStart":-1,"results":[{"id":"8ecb928edfd64f189177cc3360f7d5eb","owner":"Alexander.Simmons_FCC","created":1533828405000,"modified":1533828409000,"guid":null,"name":null,"title":"ULS_Cellular_Towers_and_Antenna_Structures_As_of_December_2017","type":"Feature Service","typeKeywords":["ArcGIS Server","Data","Feature Access","Feature Service","Service"],"description":"The Feature Service has two layers, as of January 07, 2018: Reported_Cellular_Towers and Antenna_Structure_Registration (ARS).\nCellular Tower locations layer contains nationwide cellular tower data collected by ULS that is only required for towers contributing to the outermost extent of their entire licensed coverage. \nASR Locations layer contains tower data limited to towers that require registration with the FCC.  They would be all towers over 200\u2019 and any tower less than 200\u2019 located near an airport that fails the glide slope calculation to the nearest runway. ","tags":["FCC","ULS","cellular","tower","antenna","structure"],"snippet":"Locations of ULS Cellular Towers and Antenna Structures As of January 7, 2018","thumbnail":"thumbnail/thu4C0C.png","documentation":null,"extent":[[-176.705472,-15.15],[170.784778,71.317917]],"categories":[],"spatialReference":null,"accessInformation":"FCC","classification":null,"licenseInfo":"FCC Internal Use","culture":"english (united states)","properties":null,"advancedSettings":null,"url":"https://webgis3.fcc.gov/server/rest/services/Towers_Antennas/ULS_Cellular_Towers_and_Antenna_Structures_As_of_December_2017/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":772,"scoreCompleteness":98,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1791925200000,"source":"Federal Communications Com