Type":"esriGeometryPolyline"}],"licenseInfo":"This NTAD dataset is a work of the United States government as defined in 17 U.S.C. § 101 and as such are not protected by any U.S. copyrights. This work is available for unrestricted public use.","maxRecordCount":1000,"metadata":{"metadata":{"mdContact":{"rpCntInfo":{"cntPhone":{"voiceNum":"202-875-4799"},"cntAddress":{"country":"US","eMailAdd":"april.gadsby@dot.gov","delPoint":"1200 New Jersey Ave. SE","city":"Washington","adminArea":"DC","@_addressType":"physical","postCode":20590}},"rpIndName":"April Gadsby","rpOrgName":"Bureau of Transportation Statistics (BTS)","rpPosName":"Mathematical Statistician","role":{"RoleCd":{"@_value":"007"}}},"spatRepInfo":{"VectSpatRep":{"geometObjs":{"geoObjCnt":964,"geoObjTyp":{"GeoObjTypCd":{"@_value":"003"}}}}},"mdDateSt":"2026-07-15","mdStanVer":1,"dqInfo":{"dataLineage":{"prcStep":{"stepDesc":"The National Census of Ferry Operators (NCFO)' non-geographical route attributes were gathered through a census of ferry operators. Geographical location was determined using AIS data (USACE), least-cost path analysis, 2022 NCFO data, and open source satellite imagery."}},"dqScope":{"scpLvl":{"ScopeCd":{"@_value":"005"}}},"report":{"measDesc":"Data set is considered complete for the information presented, as described in the abstract. Users are advised to read the rest of the metadata record carefully for additional details.","@_type":"DQCompOm"}},"mdHrLv":{"ScopeCd":{"@_value":"005"}},"esri":{"ArcGISFormat":1,"ArcGISProfile":"FGDC","CreaDate":"2026-07-15"},"dataIdInfo":{"idAbs":"The National Census of Ferry Operators (NCFO) Routes dataset was collected through December 31, 2022 and compiled on October 27, 2025 from the Bureau of Transportation Statistics (BTS) and is part of the U.S. Department of Transportation (USDOT)/Bureau of Transportation Statistics (BTS) National Transportation Atlas Database (NTAD). The Ferry Routes dataset represents all ferry routes from operators that provided responses to the 2022 National Census of Ferry Operators. Areas covered by the dataset include the 50 states as well as the territories of Puerto Rico, the U.S. Virgin Islands, and American Samoa. Each segment in the dataset connects two terminals from the Ferry Terminals dataset, and the route ferry vessels travel between terminals are present here. Route geometries were determined using GPS points from Automatic Identification System data, as well existing government datasets from the Census Bureau, the US Geological Survey, the National Oceanic and Atmospheric Association, and the US Army Corps of Engineers. Other routes were determined using least-cost analysis or were determined manually. A data dictionary, or other source of attribute information, is accessible at https://doi.org/10.21949/1529042","idCredit":"Acknowledgment of the Bureau of Transportation Statistics (BTS), Census Bureau, the US Geological Survey (USGS), the National Oceanic and Atmospheric Association (NOAA), and the US Army Corps of Engineers (USACE).","dataScale":{"equScale":{"rfDenom":""}},"idPurp":"This dataset can be used for analysis of transportation connections, for statistics on ridership, and for visualization purposes.","tpCat":{"TopicCatCd":{"@_value":"018"}},"idStatus":{"ProgCd":{"@_value":"004"}},"dataExt":{"geoEle":{"GeoBndBox":{"eastBL":-64.6083264372476,"exTypeCode":true,"southBL":-14.3111731662436,"northBL":61.1238552198374,"westBL":-170.681900400393}},"tempEle":{"TempExtent":{"exTemp":{"TM_Instant":{"tmPosition":"2022-12-31T00:00:00"}}}}},"envirDesc":"Version 6.2 (Build 9200) ; Esri ArcGIS 10.8.1.14362","idCitation":{"date":{"lastUpdateDate":"2025-10-27T00:00:00","pubDate":"2024-10-22T00:00:00","createDate":"2020-07-01T00:00:00"},"resTitle":"Ferry Routes","citRespParty":{"rpCntInfo":{"cntPhone":{"voiceNum":"202-875-4799"},"cntAddress":{"country":"US","eMailAdd":"april.gadsby@dot.gov","delPoint":"1200 New Jersey Ave. SE","city":"Washington","adminArea":"DC","@_addressType":"phy