et represents all ferry routes from operators that provided responses to the 2020 National Census of Ferry Operators. Areas covered by the dataset include the 50 states as well as the territories of Puerto Rico, the United States Virgin Island, and American Samoa. Each segment in the dataset connects to two terminals from the Ferry Terminals dataset, describing the route ferries travel between them. Route geometries were determined using GPS points from Automatic Identification System data, as well existing government datasets from the Census Bureau, the US Geological Survey, the National Oceanic and Atmospheric Association, and the US Army Corps of Engineers. Other routes were determined using least-cost analysis.","enableNullGeometry":false,"isUpdatableView":true,"supportedOperationsWithCollation":"query,addField,updateField","supportedSpatialRelationships":["esriSpatialRelIntersects","esriSpatialRelContains","esriSpatialRelCrosses","esriSpatialRelEnvelopeIntersects","esriSpatialRelIndexIntersects","esriSpatialRelOverlaps","esriSpatialRelTouches","esriSpatialRelWithin","esriSpatialRelDisjoint","esriSpatialRelRelation"],"geometryProperties":{"shapeLengthFieldName":"Shape__Length"},"supportsRollbackOnFailureParameter":true,"supportsTruncate":false,"standardMaxRecordCountNoGeometry":32000,"indexes":[{"indexType":"Attribute","name":"PK__PARENT_F__F4B70D85751AB83C","isUnique":true,"description":"","fields":"OBJECTID","isAscending":true},{"indexType":"Spatial","name":"user_273.PARENT_FERRY_ROUTES_FERRY_ROUTES2_Shape_sidx","isUnique":false,"description":"","fields":"Shape","isAscending":true},{"indexType":"Attribute","name":"Shape__Length_Index","isUnique":false,"description":"","fields":"Shape__Length","isAscending":true}],"supportedAppendSourceFilterFormats":"sqlite,geoPackage,shapefile,filegdb,featureService","htmlPopupType":"esriServerHTMLPopupTypeAsHTMLText","supportsReturningQueryGeometry":true,"minScale":0,"hasAttachments":false,"queryBinsCapabilities":{"supportsR