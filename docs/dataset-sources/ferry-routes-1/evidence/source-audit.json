{"all_original_attribute_geometry_values_sha256":"89c1fbe11427e17cc1f047d92ab2a0e921a39e714c540f2b23b0e664785eb2e8","all_source_attributes_ids_types_nulls_and_native_paths_retained":true,"census_year_counts":{"2020":964},"data_year_counts":{"2019":964},"feature_count":964,"item_description":"The National Census of Ferry Operators (NCFO) Routes dataset was collected through December 31, 2022 and compiled on October 27, 2025 from the Bureau of Transportation Statistics (BTS) and is part of the U.S. Department of Transportation (USDOT)/Bureau of Transportation Statistics (BTS) National Transportation Atlas Database (NTAD). The Ferry Routes dataset represents all ferry routes from operators that provided responses to the 2022 National Census of Ferry Operators. Areas covered by the dataset include the 50 states as well as the territories of Puerto Rico, the U.S. Virgin Islands, and American Samoa. Each segment in the dataset connects two terminals from the Ferry Terminals dataset, and the route ferry vessels travel between terminals are present here. Route geometries were determined using GPS points from Automatic Identification System data, as well existing government datasets from the Census Bureau, the US Geological Survey, the National Oceanic and Atmospheric Association, and the US Army Corps of Engineers. Other routes were determined using least-cost analysis or were determined manually. A data dictionary, or other source of attribute information, is accessible at https://doi.org/10.21949/1529042","layer_description":"The National Census of Ferry Operators (NCFO) Routes dataset was collected through December 31, 2020 and compiled on October 16, 2024 from the Bureau of Transportation Statistics (BTS) and is part of the U.S. Department of Transportation (USDOT)/Bureau of Transportation Statistics (BTS) National Transportation Atlas Database (NTAD). The Ferry Routes dataset represents all ferry routes from operators that provided responses to the 2020 National Census of Ferry Operators. Areas covered by the dataset include the 50 states as well as the territories of Puerto Rico, the United States Virgin Island, and American Samoa. Each segment in the dataset connects to two terminals from the Ferry Terminals dataset, describing the route ferries travel between them. Route geometries were determined using GPS points from Automatic Identification System data, as well existing government datasets from the Census Bureau, the US Geological Survey, the National Oceanic and Atmospheric Association, and the US Army Corps of Engineers. Other routes were determined using least-cost analysis.","native_path_count":964,"native_vertices":714082,"operator_count":160,"original_fields":[{"alias":"OBJECTID","defaultValue":null,"domain":null,"editable":false,"name":"OBJECTID","nullable":false,"sqlType":"sqlTypeOther","type":"esriFieldTypeOID"},{"alias":"OPERATOR_ID","defaultValue":null,"domain":null,"editable":true,"length":3,"name":"operator_id","nullable":true,"sqlType":"sqlTypeOther","type":"esriFieldTypeString"},{"alias":"segment_id","defaultValue":null,"domain":null,"editable":true,"length":4,"name":"segment_id","nullable":true,"sqlType":"sqlTypeOther","type":"esriFieldTypeString"},{"alias":"seg_length","defaultValue":null,"domain":null,"editable":true,"name":"seg_length","nullable":true,"sqlType":"sqlTypeOther","type":"esriFieldTypeDouble"},{"alias":"average_trip_time","defaultValue":null,"domain":null,"editable":true,"name":"average_trip_time","nullable":true,"sqlType":"sqlTypeOther","type":"esriFieldTypeInteger"},{"alias":"segment_season_start","defaultValue":null,"domain":null,"editable":true,"length":5,"name":"segment_season_start","nullable":true,"sqlType":"sqlTypeOther","type":"esriFieldTypeString"},{"alias":"segment_season_end","defaultValue":null,"domain":null,"editable":true,"length":5,"name":"segment_season_end","nullable":true,"sqlType":"sqlTypeOther","type":"esriFieldTypeString"},{"alias":"trips_per_year","defaultValue":null,"do