# Version control
.git/
.gitignore

# Virtual envs and caches
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
src/hifld_next_datasets.egg-info/

# Local Dagster state, databases, and credentials
.local/
.dagster_home/
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.p12

# Local data and scraper outputs (not needed at runtime; pipelines fetch fresh)
data/
dataset-source-hints.jsonl
*.csv
!HIFLD_Open_Inventory_12112025.csv

# Tests and ad-hoc scripts (image is for production execution only)
tests/
test_*.py

# Editor / IDE
.idea/
.vscode/
.cursor/
.DS_Store

# Plans / docs that aren't shipped
prompts/
dagster_expectations/

# Local env
.env
.env.*
!.env.example
