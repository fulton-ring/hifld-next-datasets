{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 7,
        "isLive": true,
        "matchesPrefix": [
          "_rollback/"
        ]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "daysSinceNoncurrentTime": 7,
        "isLive": false,
        "matchesPrefix": [
          "_rollback/"
        ]
      }
    }
  ]
}
